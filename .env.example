# Copy this file to .env (never committed).
# Public read-only guest account published on https://relational.fel.cvut.cz/dataset/Financial
BERKA_HOST=relational.fel.cvut.cz
BERKA_PORT=3306
BERKA_USER=guest
BERKA_PASSWORD=ctu-relational
BERKA_DATABASE=financial

# Local PostgreSQL warehouse (docker-compose.yml). Choose your own password in .env.
WAREHOUSE_PG_HOST=localhost
WAREHOUSE_PG_PORT=5434
WAREHOUSE_PG_USER=bank
WAREHOUSE_PG_PASSWORD=change-me
WAREHOUSE_PG_DB=bank_dw
