table fct_transactions
	lineageTag: 5e112288-314a-5a58-baee-d873a7f0aed7

	measure Transactions = COUNTROWS(fct_transactions)
		formatString: #,0
		lineageTag: 69a87940-c7fa-53d4-be2e-39a4f21a9ca6

	measure 'Volume crédits (CZK)' = CALCULATE(SUM(fct_transactions[amount]), fct_transactions[direction] = "credit")
		formatString: #,0
		lineageTag: 8b7db9bd-dbc6-52da-9765-35ffdfd6e43f

	measure 'Volume débits (CZK)' = CALCULATE(SUM(fct_transactions[amount]), fct_transactions[direction] = "debit")
		formatString: #,0
		lineageTag: d1fe61cb-ebbe-58e9-8d0e-edbe13a7d77b

