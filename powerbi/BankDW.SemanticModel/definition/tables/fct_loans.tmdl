table fct_loans
	lineageTag: 0bb9c1dc-9eb7-5157-b82e-580893debe6c

	measure Prêts = COUNTROWS(fct_loans)
		formatString: #,0
		lineageTag: 14054404-7f4c-5bfb-9e55-7371d3d43d4d

	measure 'Prêts en défaut' = CALCULATE(COUNTROWS(fct_loans), fct_loans[is_default] = TRUE())
		formatString: #,0
		lineageTag: 37755de9-b8f2-54cd-b281-e6a4e0c94efb

	measure 'Taux de défaut' = DIVIDE([Prêts en défaut], [Prêts])
		formatString: 0.0%
		lineageTag: 513582c4-566c-5fe1-b3ea-8428a70918a8

	measure 'Montant en défaut (CZK)' = SUM(fct_loans[amount_in_default])
		formatString: #,0
		lineageTag: ae35a1bc-83bb-5344-96e3-7734afa226b2

	measure 'Solde minimum moyen avant prêt (CZK)' = AVERAGE(fct_loans[min_balance_before])
		formatString: #,0
		lineageTag: ee8dbe45-94c7-5b06-9756-b01422af1d3e

	measure 'Solde moyen avant prêt (CZK)' = AVERAGE(fct_loans[avg_month_end_balance_before])
		formatString: #,0
		lineageTag: 9d392bf5-4bc0-5654-9b90-400d45885f67

	measure 'Jours à découvert avant prêt (moyenne)' = AVERAGE(fct_loans[n_days_negative_balance_before])
		formatString: 0.00
		lineageTag: eabc8e10-662d-5aaa-9ee7-b05faaaed0d2

	measure 'Pénalités avant prêt (moyenne)' = AVERAGE(fct_loans[n_penalty_interest_before])
		formatString: 0.00
		lineageTag: 657dce66-1c94-526c-8575-49ed24826489

